[Unit]
Description=Spectre public ephemeral rooms
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=spectre-link
Group=spectre-link
WorkingDirectory=/opt/spectre-link/current
ExecStart=/opt/spectre-link/current/entrypoint.sh run
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spectre-link-canary
UMask=0077
EnvironmentFile=-/etc/spectre-link/environment
Environment=PORT=4000
Environment=SPECTRE_ORIGIN=https://spectre.micutu.com
Environment=HOME=/run/spectre-link
Environment=ERL_MAX_PORTS=1024
Environment=ERL_CRASH_DUMP=/dev/null
Environment="ERL_FLAGS=+S 2:2 +SDcpu 1 +SDio 1 +A 2"
RuntimeDirectory=spectre-link
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/srv /root /home -/var/www -/etc/cloudflared -/etc/letsencrypt
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=128
LimitNOFILE=2048
LimitCORE=0
MemoryHigh=384M
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
